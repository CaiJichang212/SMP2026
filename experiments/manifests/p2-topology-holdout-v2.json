{
  "schema_version": 2,
  "name": "p2-component-degree-plus-one-topology-holdout-v2",
  "randomization_seed": 20260906,
  "server_url_env": "SMP_SERVER_URL",
  "timeout_seconds": 60,
  "topology_holdout_required": true,
  "response_protocol": {
